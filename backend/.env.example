# Vistara Agricultural Diagnostic Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Vercel AI Gateway Configuration
# Key provided by Vercel AI Gateway Dashboard
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here

# Target Vision-Language Model
AI_MODEL_ID=alibaba/qwen3.7-flash

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Payload Body Limit for Leaf Images
BODY_LIMIT=50mb

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/vistara_diagnostics
MONGODB_DB_NAME=vistara_diagnostics
